# Stockroom: Vercel (Next.js server) -> Cloudflare D1
# Fill these in Vercel Project Settings > Environment Variables, then redeploy.
# For local development copy this file to .env.local and use a separate test DB.
# NEVER prefix these names with NEXT_PUBLIC_ or commit real credentials.

# Cloudflare account containing your own D1 database (32 hexadecimal characters).
CLOUDFLARE_ACCOUNT_ID=

# D1 database UUID from Cloudflare > Storage & databases > D1 > your database.
CLOUDFLARE_D1_DATABASE_ID=

# Cloudflare API token with Account > D1 > Edit, restricted to that account.
# Store as a secret in Vercel. Do not use a Global API Key.
CLOUDFLARE_API_TOKEN=

# First initialize a NEW empty D1 database using drizzle/0000_red_northstar.sql.
# No database or token is created by this template. Existing Sites stock is NOT
# automatically copied: download its JSON backup and restore it on the new site.
# See docs/VERCEL.md for setup, access protection and verification steps.
